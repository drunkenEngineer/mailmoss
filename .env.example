# Copy to .env and fill in. Neither value is secret: the OAuth client is a public
# installed-app client, and the key is the extension's public key.

# OAuth 2.0 client ID, type "Chrome Extension", created in Google Cloud Console.
# Used for the default sign-in, which silently uses whichever account Chrome is
# signed in with.
VITE_OAUTH_CLIENT_ID=

# OAuth 2.0 client ID, type "Web application", with the authorised redirect URI
# https://<extension-id>.chromiumapp.org/
# Optional. Without it the "use a different account" option is hidden, because
# Chrome's own sign-in offers no account picker.
VITE_OAUTH_WEB_CLIENT_ID=

# Base64 public key that pins the extension ID across reloads.
# chrome://extensions -> Pack extension -> extract the public key from the .pem.
VITE_EXTENSION_KEY=
